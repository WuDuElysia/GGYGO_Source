# 默认不做自动文本探测，避免 UE 二进制资产被误当文本处理。
* -text

# ------------------------------------------------------------
# 文本文件：仓库内统一 LF 存储，检出时按平台转换
# ------------------------------------------------------------
*.h         text eol=lf diff=cpp
*.hpp       text eol=lf diff=cpp
*.cpp       text eol=lf diff=cpp
*.inl       text eol=lf diff=cpp
*.cs        text eol=lf diff=csharp
*.py        text eol=lf diff=python
*.md        text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.csv       text eol=lf
*.usf       text eol=lf
*.ush       text eol=lf
*.hlsl      text eol=lf
*.uproject  text eol=lf
*.uplugin   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf

# Windows 批处理必须保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ------------------------------------------------------------
